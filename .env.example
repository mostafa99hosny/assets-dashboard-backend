# Runtime
NODE_ENV=development
PORT=5000
TRUST_PROXY=false

# MongoDB. Use a dedicated Atlas/database user with read-only permissions.
# Never expose either Mongo value to the frontend or commit a real connection string.
MONGO_URL_SCRAPPING=mongodb+srv://READ_ONLY_USER:REPLACE_ME@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGO_DBNAME_SCRAPPING=ElectronDB

# The ObjectId of the company this independently deployed dashboard may serve.
DEFAULT_COMPANY_ID=REPLACE_WITH_24_HEX_CHARACTER_OBJECT_ID

# Comma-separated exact browser origins for the separately deployed frontend.
# Do not use *. Add production and local origins explicitly.
CORS_ORIGINS=http://localhost:3000,https://dashboard.example.com
CORS_ALLOW_NO_ORIGIN=true

# Defensive server-side limits.
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
EXPORT_MAX_ROWS=10000
FILTER_OPTIONS_LIMIT=250
MONGO_MAX_POOL_SIZE=10
MONGO_QUERY_TIMEOUT_MS=10000

# Socket.IO / MongoDB Change Stream reconnection backoff in milliseconds.
# HTTP endpoints remain available while a stream is reconnecting.
REALTIME_RETRY_INITIAL_MS=1000
REALTIME_RETRY_MAX_MS=30000
